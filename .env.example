# WebMap Environment Configuration
# Copy this file to .env and set your values
# IMPORTANT: Never commit .env to version control!

# Django Secret Key (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-50-character-random-secret-key-here-CHANGE-THIS

# Debug Mode (default: False)
# Set to True ONLY for development, NEVER in production
DEBUG=False

# Allowed Hosts (comma-separated)
# List of hostnames/IPs that can serve the application
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# HTTPS Settings (uncomment if using HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Database (if different from default)
# DATABASE_URL=sqlite:///opt/nmapdashboard/db.sqlite3

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=WARNING
