# WebMap environment configuration
# Use with: docker run --env-file .env ...
# Never commit a filled-in .env file. Full reference: docs/configuration.md

# Signing key (required in practice: without it every restart logs you out)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-50-character-random-value

# Never true on an instance anyone else can reach
DEBUG=false

# Host names the app answers to (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Login user, created/updated at every start
WEBMAP_USER=webmap
WEBMAP_PASSWORD=replace-with-a-strong-password
# or, with a Docker secret instead of WEBMAP_PASSWORD:
# WEBMAP_PASSWORD_FILE=/run/secrets/webmap_password

# Failed-login limit
# WEBMAP_LOGIN_MAX_FAILURES=5
# WEBMAP_LOGIN_LOCKOUT_SECONDS=900

# Behind a TLS reverse proxy (see docs/deployment.md)
# WEBMAP_HTTPS=true
# CSRF_TRUSTED_ORIGINS=https://webmap.example.internal
# WEBMAP_TRUSTED_PROXY=true
# WEBMAP_SSL_REDIRECT=true
# WEBMAP_HSTS_SECONDS=3600

# Logging (nmapreport loggers)
# WEBMAP_LOG_LEVEL=INFO

# Limits
# WEBMAP_MAX_XML_MB=100
# WEBMAP_SCAN_CACHE=4
