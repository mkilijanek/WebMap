# Bandit configuration (INI, read with: bandit -r . --ini .bandit)
# https://bandit.readthedocs.io/en/latest/config.html
#
# B101 assert: only used in tests.
# B404/B603 subprocess: the one call (api.genPDF) runs a fixed argv list
# without a shell; nothing from the request reaches the command line.
[bandit]
exclude = ./tests.py,./static,./.git,./.github
skips = B101,B404,B603
